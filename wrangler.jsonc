{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzz-cf-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "BuzzBridge", "class_name": "BuzzBridge" },
      { "name": "ThinkAgent", "class_name": "ThinkAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BuzzBridge", "ThinkAgent"] }
  ],
  "vars": {
    "BUZZ_RELAY_URL": "wss://your-relay.communities.buzz.xyz",
    "POLL_SECONDS": "15",
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "BUZZ_CHANNEL_IDS": "your-channel-uuid"
  }
}
