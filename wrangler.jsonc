{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzz-cf-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [{ "name": "Think", "class_name": "Think" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Think"] }],
  "vars": {
    "AGENT_NAME": "Think",
    "BUZZ_RELAY_URL": "wss://thomas-test-env.communities.buzz.xyz",
    "POLL_SECONDS": "15",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  }
}
